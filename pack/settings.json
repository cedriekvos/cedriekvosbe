{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PACK_DIR/bin/notify_hook.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f \"$PACK_DIR/queue/.waiting_$PACK_AGENT\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PACK_DIR/bin/stop_hook.py\""
          }
        ]
      }
    ]
  }
}
