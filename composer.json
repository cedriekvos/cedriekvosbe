{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/cedriekvos/laravel-composer-audit",
            "no-api": true,
            "_comment": [
                "This entry exists because the package is not on Packagist.",
                "no-api makes composer update and outdated read its versions from a git clone over HTTPS instead of the GitHub API, whose anonymous limit of 60 requests an hour runs out after a few runs.",
                "composer update therefore needs git; composer install does not, because it downloads the zip recorded in composer.lock."
            ]
        }
    ],
    "require": {
        "php": "8.4.*",
        "cedriekvos/laravel-composer-audit": "^1.0",
        "laravel/framework": "^13.8",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.6",
        "livewire/livewire": "^4.2",
        "symfony/yaml": "^8.1.0",
        "tempest/highlight": "^2.27"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3",
        "laravel/boost": "^2",
        "laravel/breeze": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpunit/phpunit": "^13.3.1",
        "rector/rector": "^2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "@playwright:install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@playwright:install",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@audit:stale-ignores"
        ],
        "audit:stale-ignores": [
            "@php -r '$ignored = array_keys(json_decode(file_get_contents(\"composer.json\"), true)[\"config\"][\"policy\"][\"abandoned\"][\"ignore\"] ?? []); $lock = json_decode(file_get_contents(\"composer.lock\"), true); $abandoned = array_column(array_filter([...$lock[\"packages\"], ...$lock[\"packages-dev\"]], fn (array $package): bool => ($package[\"abandoned\"] ?? false) !== false), \"name\"); $stale = array_diff($ignored, $abandoned); array_walk($stale, fn (string $name) => fwrite(STDERR, $name . \" is no longer an installed abandoned package: remove it from config.policy.abandoned.ignore in composer.json.\" . PHP_EOL)); exit($stale === [] ? 0 : 1);'"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "qa": [
            "Composer\\Config::disableProcessTimeout",
            "composer validate",
            "@audit:stale-ignores",
            "./vendor/bin/rector process --dry-run --clear-cache",
            "./vendor/bin/pint --test --cache-file=/dev/null",
            "./vendor/bin/phpstan clear-result-cache",
            "./vendor/bin/phpstan analyse",
            "./vendor/bin/pest --testsuite=Architecture",
            "./vendor/bin/pest --testsuite=Feature",
            "./vendor/bin/pest --testsuite=Unit",
            "./vendor/bin/pest --exclude-testsuite=Browser --coverage --min=100",
            "./vendor/bin/pest --exclude-testsuite=Browser --type-coverage --min=100",
            "./vendor/bin/pest --exclude-testsuite=Browser --mutate --min=100 --no-cache",
            "npm run build",
            "@playwright:install",
            "./vendor/bin/pest --testsuite=Browser",
            "echo QA passed"
        ],
        "qa:fast": [
            "Composer\\Config::disableProcessTimeout",
            "composer validate",
            "@audit:stale-ignores",
            "npm run build",
            "./vendor/bin/rector process --dry-run",
            "./vendor/bin/pint --test",
            "./vendor/bin/phpstan analyse",
            "./vendor/bin/pest tests/Architecture/FeatureTraceTest.php",
            "@playwright:install",
            "./vendor/bin/pest --parallel --tia",
            "./vendor/bin/pest --parallel --exclude-testsuite=Browser --coverage --min=100",
            "./vendor/bin/pest --parallel --exclude-testsuite=Browser --type-coverage --min=100",
            "echo QA '(fast)' passed"
        ],
        "fix-qa": [
            "./vendor/bin/rector process",
            "./vendor/bin/pint",
            "echo QA fixed"
        ],
        "playwright:install": [
            "npx playwright install chromium"
        ],
        "phpmd:install": [
            "curl -sSLf -o bin/phpmd.phar https://github.com/phpmd/phpmd/releases/download/2.15.0/phpmd.phar",
            "chmod +x bin/phpmd.phar",
            "echo PHPMD installed"
        ],
        "phpmd": [
            "@php bin/phpmd.phar app text cleancode"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "abandoned": {
                "ignore": {
                    "symplify/rule-doc-generator-contracts": "Dev-only, interfaces only; required by driftingly/rector-laravel, which has no release without it yet."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
